{
  "name": "tarefa-nodejs",
  "version": "1.0.0",
  "type": "module",
  "description": "Implemente, dentro deste repositório, a API descrita no enunciado da tarefa (PDF em anexo na plataforma): \r gerenciamento de projetos, tarefas e usuários, com autenticação\r JWT e controle de acesso baseado em papéis (RBAC: `admin` e `user`). O contrato exato de\r rotas, payloads e códigos HTTP que sua API precisa seguir está em\r **[`docs/CONTRATO_API.pdf`](docs/CONTRATO_API.pdf)**. Leia esse arquivo com atenção, é ele\r que a correção automática usa como referência.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node build/server.js",
    "build": "tsup src/server.ts --format esm --out-dir build",
    "postinstall": "prisma generate",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriquevcm07/Tarefa-NodeJs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/henriquevcm07/Tarefa-NodeJs/issues"
  },
  "homepage": "https://github.com/henriquevcm07/Tarefa-NodeJs#readme",
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.4",
    "fastify": "5.12.5",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.12",
    "pg": "8.23.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "26.6.3",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
